{
  "name": "bitcoin-node-scanner",
  "version": "0.1.0",
  "description": "Bitcoin node scanner that scans for BTC nodes via publicly known DNS, random IPs and user-specified IPs. Does scan peer's peers.",
  "type": "module",
  "main": "src/index.mts",
  "repository": "https://github.com/OriginalEveres/bitcoin-node-scanner.git",
  "author": "Matej Husak",
  "license": "MIT",
  "bin": {
    "btc-crawl": "src/cli/crawl.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx/esm --test src/**/tests/*.test.ts",
    "crawl": "tsx src/cli/crawl.ts",
"lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
